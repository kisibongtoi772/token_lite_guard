# ============================================================
# token_lite_guard — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Database ---
# Path to SQLite database file. Created automatically on first run.
DB_PATH=./data/token_guard.db

# ============================================================
# Provider API Keys
# Configure one or more providers below.
# Keys left blank will cause requests to that provider to fail.
# ============================================================

# --- OpenAI ---
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo, o1, o1-mini, o3-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# Models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Google Gemini ---
# Models: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Mistral AI ---
# Models: mistral-large-latest, mistral-medium-latest, mistral-small-latest, codestral-latest
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Groq ---
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Together AI ---
# Models: meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo, mistralai/Mixtral-8x7B-Instruct-v0.1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

# --- DeepSeek ---
# Models: deepseek-chat, deepseek-coder, deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Cohere ---
# Models: command-r-plus, command-r, command-light
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/compatibility/v1

# --- Azure OpenAI ---
# Requires AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_VERSION in addition to key.
# Model name maps to your Azure deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Ollama (Local) ---
# Runs locally — no API key required.
# Ensure Ollama is running: `ollama serve`
# Models: llama3.2, qwen2.5-coder, phi4, gemma3, mistral, etc.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# --- LM Studio (Local) ---
# Runs locally — no API key required.
# Start LM Studio local server first.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# ============================================================
# Security
# ============================================================

# Admin secret key for dashboard access (optional).
# If set, the dashboard will require this key to be provided via
# the X-Admin-Secret header or ?admin_secret= query parameter.
ADMIN_SECRET=

# ============================================================
# Budget & Quota Defaults
# ============================================================

# Default token budget applied to newly created virtual keys.
# Set to 0 for unlimited by default.
DEFAULT_BUDGET_TOKENS=100000

# Request timeout in seconds for upstream provider calls.
UPSTREAM_TIMEOUT_SECONDS=120
