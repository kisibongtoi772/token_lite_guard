# ============================================================
# token_lite_guard — Environment Configuration
# Copy this file to .env and fill in your real values
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Database ---
# Path to SQLite database file (auto-created on first run)
DB_PATH=./data/token_guard.db

# --- OpenAI Provider ---
# Your REAL OpenAI API key (never commit this!)
OPENAI_API_KEY=sk-your-real-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic Provider ---
# Your REAL Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-real-anthropic-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Security ---
# Secret key for admin dashboard (optional, leave empty to disable auth)
ADMIN_SECRET=

# --- Budget Defaults ---
# Default token budget for new virtual keys (0 = unlimited)
DEFAULT_BUDGET_TOKENS=100000
